{
  "name": "frey-codegen",
  "version": "1.0.0",
  "description": "Interactive CLI generator for file and folder templates with placeholder substitution.",
  "keywords": [
    "cli",
    "codegen",
    "code-generator",
    "scaffold",
    "scaffolding",
    "template",
    "templates",
    "generator",
    "boilerplate"
  ],
  "author": "Sergey Frey <sergey.frey.work@gmail.com>",
  "license": "MIT",
  "bin": {
    "fcode": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build && chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "link": "npm run build && npm link",
    "lint": "oxlint",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src"
  },
  "dependencies": {
    "ignore": "^7.0.6",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/prompts": "^2.4.9",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-dts": "^5.0.3"
  }
}
